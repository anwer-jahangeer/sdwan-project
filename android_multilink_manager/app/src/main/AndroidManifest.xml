<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Deliberately minimal, "normal" permission set only.

      INTERNET / ACCESS_NETWORK_STATE / CHANGE_NETWORK_STATE /
      ACCESS_WIFI_STATE are declared "normal" permissions by the platform:
      they are granted automatically at install time and never trigger a
      runtime prompt.

      This app intentionally does NOT request:
        - ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION (would be required
          only to read live Wi-Fi SSID/BSSID/RSSI on newer Android
          versions; this app does not need per-AP identity, only
          transport/validated/metered/bandwidth-estimate capability data,
          so it is skipped),
        - READ_PHONE_STATE (would be required only for detailed cellular
          subscription/carrier display info beyond what NetworkCapabilities
          already exposes),
        - TETHER_PRIVILEGED, WRITE_SECURE_SETTINGS, or any other
          privileged/signature permission (these require system/OEM
          signing or a privileged app slot; a normal, non-rooted app can
          never legitimately hold them), and
        - any VPN permission (this app never creates a VpnService).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Declares that this app can run without a hardware camera/etc. is
         not needed here; no <uses-feature> restrictions are required. -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MultiLinkManager">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MultiLinkManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
